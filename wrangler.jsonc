{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "routes": [
    {
      "pattern": "store.article6.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "store-db",
      "database_id": "8235d261-06ca-4e05-8304-1e40d74a6a9f"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://store.article6.org",
    "EMAIL_FROM": "School Ledger <no-reply@article6.org>",
    "PLATFORM_ADMIN_EMAILS": "fredilly@gmail.com"
  }
}
