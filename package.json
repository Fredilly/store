{
  "name": "school-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply store-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply store-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test:core": "bash scripts/core-regression.sh",
    "test:authz": "bash scripts/authz-regression.sh",
    "test:acceptance": "npm run test:authz && npm run test:core && npm run test:product-setup && npm run test:onboarding && npm run test:readability && npm run test:icons && npm run test:icon-visibility && npm run test:form-readability && npm run test:welcome-branding && npm run test:email-copy && npm run test:signup && npm run test:signup-errors && npm run test:corrections && npm run test:fraud-visibility && npm run test:history",
    "test:product-setup": "bash scripts/product-setup-regression.sh",
    "test:onboarding": "bash scripts/onboarding-regression.sh",
    "test:readability": "bash scripts/readability-regression.sh",
    "test:icons": "bash scripts/icon-regression.sh",
    "test:icon-visibility": "bash scripts/icon-visibility-regression.sh",
    "test:form-readability": "bash scripts/form-readability-regression.sh",
    "test:welcome-branding": "bash scripts/welcome-branding-regression.sh",
    "test:email-copy": "bash scripts/email-copy-regression.sh",
    "test:signup": "bash scripts/signup-regression.sh",
    "test:signup-errors": "bash scripts/signup-error-regression.sh",
    "test:corrections": "bash scripts/corrections-regression.sh",
    "test:fraud-visibility": "bash scripts/fraud-visibility-regression.sh",
    "test:history": "bash scripts/history-regression.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "better-auth": "1.7.5",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.135.0"
  }
}
